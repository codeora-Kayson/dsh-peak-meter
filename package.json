{
  "name": "dsh-peak-meter",
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "market": "node scripts/market.mjs"
  },
  "description": "DS时段费用参考 — DeepSeek 平峰/高峰、本会话与本轮费用、账户余额，显示在输入框下方。",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "deepseek", "pricing", "cost", "harness"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeora-Kayson/dsh-peak-meter.git"
  },
  "homepage": "https://github.com/codeora-Kayson/dsh-peak-meter",
  "bugs": {
    "url": "https://github.com/codeora-Kayson/dsh-peak-meter/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
